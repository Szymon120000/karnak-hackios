diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index c09c299..c8a0400 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -495,6 +495,74 @@ start_cpu:
 2:
 .endmacro
 
+#if defined(KARNAK)
+/*
+ * Bring-up bisection bar.  MMU and caches are off, so the panel's physical
+ * base is directly addressable.  Use the fixed karnak geometry (see
+ * include/karnak/hardware_map.h) rather than boot_args->Video, because the
+ * loader may deliberately pass no video address.  Paint 32 rows \rowback
+ * rows above the bottom with \color; distinct rows/colours mark successive
+ * points in the pre-MMU path.  Clobbers x9-x14 only, never x20-x26 or lr.
+ */
+	.macro	KARNAK_BAR rowback, color
+	MOV64		x9, 0x98800000			// KARNAK_FB_BASE_FALLBACK
+	mov		w10, #3200			// KARNAK_FB_STRIDE
+	mov		w11, #1280			// KARNAK_FB_HEIGHT
+	mov		w12, #(\rowback)
+	cmp		w11, w12
+	b.lo		99f
+	sub		w11, w11, w12			// start \rowback rows above bottom
+	umaddl		x9, w11, w10, x9
+	mov		w11, #800			// KARNAK_FB_WIDTH
+	MOV64		x12, \color
+	mov		w13, #32
+98:	mov		w14, w11
+97:	str		w12, [x9], #4
+	subs		w14, w14, #1
+	b.ne		97b
+	subs		w13, w13, #1
+	b.ne		98b
+99:
+	.endm
+
+/*
+ * Identity-map the first 8 MiB of the panel's physical framebuffer so the
+ * post-MMU markers can still write to it.  The bootstrap V=P window only
+ * covers DRAM from the kernel base upward, and the panel sits at 0x98800000.
+ * Use Device-nGnRnE (uncached) so the pixels reach DRAM without a cache
+ * clean; arm_replace_identity_map() wipes this mapping later, which is fine.
+ * Clobbers x0, x2, x10-x13.  Expects x1 = V=P L1 table, x2 = free PT page.
+ */
+	.macro	KARNAK_MAP_FB
+	MOV64		x0, 0x98800000			// KARNAK_FB_BASE_FALLBACK
+	add		x2, x2, PGBYTES			// new L2 page
+	mov		x11, #(ARM_TTE_BOOT_TABLE)
+	and		x12, x2, #(ARM_TTE_TABLE_MASK)
+	orr		x11, x11, x12
+	and		x10, x0, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x10, x10, #(ARM_TT_L1_SHIFT)
+	lsl		x10, x10, #(TTE_SHIFT)
+	add		x10, x1, x10
+	str		x11, [x10]
+	and		x10, x0, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x10, x10, #(ARM_TT_L2_SHIFT)
+	lsl		x10, x10, #(TTE_SHIFT)
+	add		x10, x2, x10
+	mov		x11, #(ARM_TTE_TYPE_BLOCK)
+	orr		x11, x11, #(ARM_TTE_VALID)
+	orr		x11, x11, #(ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE))
+	orr		x11, x11, #(ARM_TTE_BLOCK_AF)
+	and		x12, x0, #(ARM_TTE_BLOCK_L2_MASK)
+	orr		x11, x11, x12
+	mov		x13, #4				// 4 x 2 MiB blocks
+1:	str		x11, [x10], #(1 << TTE_SHIFT)
+	add		x11, x11, #(ARM_TT_L2_SIZE)
+	subs		x13, x13, #1
+	b.ne		1b
+	dsb		ish
+	.endm
+#endif /* KARNAK */
+
 /*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
@@ -511,6 +579,11 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(KARNAK)
+	/* M0: reached _start_first_cpu with boot_args intact. */
+	KARNAK_BAR 192, 0xFF0000FF
+#endif /* KARNAK */
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -660,6 +733,13 @@ Lkernelcache_base_found:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+#if defined(KARNAK)
+	/* M1: bootstrap V=P and KVA page tables built successfully. */
+	KARNAK_BAR 256, 0xFF00FF00
+	/* Add an identity window for the panel so later markers can draw. */
+	KARNAK_MAP_FB
+#endif /* KARNAK */
+
 
 	b		common_start
 
@@ -788,11 +868,21 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+#if defined(KARNAK)
+	/* M2: about to enable the MMU (all common_start setup succeeded). */
+	KARNAK_BAR 320, 0xFFFF0000
+#endif /* KARNAK */
+
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(KARNAK)
+	/* M3: the MMU is on and this instruction ran from the identity map. */
+	KARNAK_BAR 384, 0xFFFF00FF
+#endif /* KARNAK */
+
 #if !VMAPPLE && !defined(KARNAK)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -855,6 +945,11 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if defined(KARNAK)
+	/* M4: common_start completed; about to return to arm_init(). */
+	KARNAK_BAR 448, 0xFFFFFF00
+#endif /* KARNAK */
+
 	// Return to arm_init()
 	ret
 
