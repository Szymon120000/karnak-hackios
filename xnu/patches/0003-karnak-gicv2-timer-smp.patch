diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3ad743f..ef29390 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -9,10 +9,135 @@
 #include <machine/atomic.h>
 #include <machine/machine_routines.h>
 #include <pexpert/device_tree.h>
+#include <pexpert/pexpert.h>
 #include <pexpert/arm64/board_config.h>
 
 
-#if HAS_GIC_V3
+#if defined(KARNAK)
+/*
+ * karnak: non-secure GIC-400 (GICv2).  There is no system-register CPU
+ * interface, so every access is MMIO.  Firmware may leave secure-owned
+ * interrupts configured; mask all SPIs and route the PPIs/SGI we own to
+ * Group 1, which is what a non-secure kernel can receive.
+ */
+static vm_offset_t karnak_gicd_base;
+static vm_offset_t karnak_gicc_base;
+
+static inline uint32_t
+karnak_gic_read(vm_offset_t base, uint32_t offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static inline void
+karnak_gic_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+}
+
+uint32_t
+karnak_gicv2_ack(void)
+{
+	return karnak_gic_read(karnak_gicc_base, KARNAK_GICC_IAR);
+}
+
+void
+karnak_gicv2_eoi(uint32_t iar)
+{
+	karnak_gic_write(karnak_gicc_base, KARNAK_GICC_EOIR, iar);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+karnak_gicv2_send_sgi(unsigned int aff0)
+{
+	uint32_t value;
+
+	if (aff0 >= 8) {
+		panic("KARNAK GIC: SGI target %u is outside the GICv2 target list", aff0);
+	}
+	value = ((uint32_t)KARNAK_IPI_SGI << KARNAK_GICD_SGIR_SGI_SHIFT) |
+	    ((1U << aff0) << KARNAK_GICD_SGIR_TARGET_SHIFT) |
+	    (KARNAK_GICD_SGIR_FILTER_LIST << KARNAK_GICD_SGIR_FILTER_SHIFT);
+	__builtin_arm_dsb(DSB_ISHST);
+	karnak_gic_write(karnak_gicd_base, KARNAK_GICD_SGIR, value);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static void
+karnak_gicv2_map(void)
+{
+	uint32_t lines;
+
+	if (karnak_gicd_base != 0) {
+		return;
+	}
+
+	karnak_gicd_base = ml_io_map((vm_offset_t)KARNAK_GICD_PA, 0x1000);
+	karnak_gicc_base = ml_io_map((vm_offset_t)KARNAK_GICC_PA, 0x2000);
+	if (karnak_gicd_base == 0 || karnak_gicc_base == 0) {
+		panic("KARNAK GIC: cannot map GIC-400 distributor/CPU interface");
+	}
+
+	/* Mask and clear every SPI bank; no peripheral driver owns one yet. */
+	lines = karnak_gic_read(karnak_gicd_base, KARNAK_GICD_TYPER) &
+	    KARNAK_GICD_TYPER_LINES;
+	for (uint32_t bank = 1; bank <= lines; bank++) {
+		karnak_gic_write(karnak_gicd_base, KARNAK_GICD_ICENABLER + bank * 4, 0xFFFFFFFFU);
+		karnak_gic_write(karnak_gicd_base, KARNAK_GICD_ICPENDR + bank * 4, 0xFFFFFFFFU);
+		karnak_gic_write(karnak_gicd_base, KARNAK_GICD_IGROUPR + bank * 4, 0xFFFFFFFFU);
+	}
+
+	karnak_gic_write(karnak_gicd_base, KARNAK_GICD_CTLR,
+	    karnak_gic_read(karnak_gicd_base, KARNAK_GICD_CTLR) |
+	    KARNAK_GICD_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+
+	kprintf("KARNAK GIC: GICv2 IRQ ready, timer=%u, SGI=%u, CNTFRQ=%llu Hz\n",
+	    KARNAK_TIMER_INTID, KARNAK_IPI_SGI,
+	    __builtin_arm_rsr64("CNTFRQ_EL0"));
+}
+
+static void
+karnak_gicv2_init_cpu(void)
+{
+	const uint32_t sources = (1U << KARNAK_TIMER_INTID) | (1U << KARNAK_IPI_SGI);
+	uint32_t ctlr;
+
+	karnak_gicv2_map();
+
+	/* PPI and SGI registers are banked per CPU in the distributor. */
+	karnak_gic_write(karnak_gicd_base, KARNAK_GICD_ICENABLER, 0xFFFFFFFFU);
+	karnak_gic_write(karnak_gicd_base, KARNAK_GICD_ICPENDR, 0xFFFFFFFFU);
+	karnak_gic_write(karnak_gicd_base, KARNAK_GICD_IGROUPR,
+	    karnak_gic_read(karnak_gicd_base, KARNAK_GICD_IGROUPR) | sources);
+
+	*(volatile uint8_t *)(karnak_gicd_base + KARNAK_GICD_IPRIORITYR +
+	    KARNAK_IPI_SGI) = 0x80;
+	*(volatile uint8_t *)(karnak_gicd_base + KARNAK_GICD_IPRIORITYR +
+	    KARNAK_TIMER_INTID) = 0xA0;
+
+	karnak_gic_write(karnak_gicd_base, KARNAK_GICD_ISENABLER, sources);
+
+	/* Combined EOI (EOImode = 0), no FIQ bypass, Group 1 enabled. */
+	ctlr = karnak_gic_read(karnak_gicc_base, KARNAK_GICC_CTLR);
+	ctlr &= ~(KARNAK_GICC_CTLR_EOIMODE | KARNAK_GICC_CTLR_FIQEN);
+	ctlr |= KARNAK_GICC_CTLR_ENABLEGRP1;
+	karnak_gic_write(karnak_gicc_base, KARNAK_GICC_CTLR, ctlr);
+	karnak_gic_write(karnak_gicc_base, KARNAK_GICC_PMR, 0xFF);
+	karnak_gic_write(karnak_gicc_base, KARNAK_GICC_BPR, 0);
+
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
+void
+pe_init_fiq(void)
+{
+	karnak_gicv2_init_cpu();
+}
