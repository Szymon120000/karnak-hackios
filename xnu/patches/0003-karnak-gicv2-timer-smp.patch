+#if defined(KARNAK)
+/*
+ * PSCI CPU_ON entry for karnak (physical address, x0 = context id, no stack,
+ * MMU and caches off).  Firmware may return at EL1 or EL2; check before
+ * touching EL1 state.  The EL2 path assumes no resident hypervisor and
+ * CNTVOFF_EL2 = 0 on boot.  GIC-400 has no system-register interface, so
+ * there is no ICC_SRE_EL2 access here.
+ */
+	.align 2
+	.globl EXT(karnak_secondary_entry)
+LEXT(karnak_secondary_entry)
+	msr		DAIFSet, #0xf
+	mrs		x1, CurrentEL
+	cmp		x1, #0x4
+	b.eq	Lkarnak_secondary_el1
+	cmp		x1, #0x8
+	b.ne	Lkarnak_secondary_bad_el
+
+	adrp	x1, EXT(LowExceptionVectorBase)@page
+	add		x1, x1, EXT(LowExceptionVectorBase)@pageoff
+	msr		VBAR_EL2, x1
+	/* No stage 2, AArch64 EL1, no EL2 interrupt or FP/debug traps. */
+	mov		x1, #(1 << 31)
+	msr		HCR_EL2, x1
+	msr		VTTBR_EL2, xzr
+	msr		CPTR_EL2, xzr
+	msr		MDCR_EL2, xzr
+	mov		x1, #3
+	msr		CNTHCTL_EL2, x1
+	msr		CNTVOFF_EL2, xzr
+	/* Known Armv8 RES1 bits, M/C/I off, little endian. */
+	MOV64	x1, 0x30d00800
+	msr		SCTLR_EL1, x1
+	isb
+	adrp	x1, Lkarnak_secondary_el1@page
+	add		x1, x1, Lkarnak_secondary_el1@pageoff
+	msr		ELR_EL2, x1
+	mov		x1, #0x3c5			// DAIF masked, AArch64 EL1h
+	msr		SPSR_EL2, x1
+	eret
+Lkarnak_secondary_bad_el:
+	b		.
+Lkarnak_secondary_el1:
+	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
+	msr		SPSel, #1
+	b		EXT(LowResetVectorBase)
+#endif /* KARNAK */
+
