/** @file
  XnuLoader UEFI application: validate an ARM64 kernelcache and hand off.

  SPDX-License-Identifier: BSD-2-Clause-Patent
**/
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = XnuLoader
  FILE_GUID                      = 5B0E7C2A-4D19-4C61-9F3E-2A8D6B1C0E77
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = UefiMain

[Sources]
  XnuLoader.c

[Packages]
  MdePkg/MdePkg.dec
  XnuLoaderPkg/XnuLoaderPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  KarnakBootArgsLib
  KarnakHandoffLib
  XnuImageLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiGraphicsOutputProtocolGuid

[Guids]
  gEfiFileInfoGuid
