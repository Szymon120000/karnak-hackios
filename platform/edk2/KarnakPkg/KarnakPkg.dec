[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = KarnakPkg
  PACKAGE_GUID                   = 7B3F4C2E-9D41-4A7B-8C15-2E6A0B7C9D31
  PACKAGE_VERSION                = 1.0

[Includes]
  Include

[LibraryClasses]
  ##  @libraryclass  Reads the live device tree published by KarnakBootShim.
  KarnakFdtLib|Include/Library/KarnakFdtLib.h

[Guids]
  gKarnakPkgTokenSpaceGuid        = { 0x5a1e8c40, 0x3b27, 0x4f6d, { 0x9a, 0x11, 0x7c, 0x2d, 0x84, 0x55, 0x0e, 0x93 } }

[PcdsFixedAtBuild.common]
  # Filled by KarnakBootShim before control reaches the EDK2 FD.
  #   *(UINT64 *)PcdDeviceTreeStore == address of the stable DTB copy
  gKarnakPkgTokenSpaceGuid.PcdDeviceTreeStore|0x4FF00000|UINT64|0x00010001
  gKarnakPkgTokenSpaceGuid.PcdDtbStoreBase|0x4FE00000|UINT64|0x00010002
  gKarnakPkgTokenSpaceGuid.PcdDtbStoreSize|0x00100000|UINT32|0x00010003
  gKarnakPkgTokenSpaceGuid.PcdKarnakUartBase|0x11002000|UINT32|0x00010004
